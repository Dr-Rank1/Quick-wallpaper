<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/native_ad_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ad_card_background"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Ad attribution badge -->
    <TextView
        android:id="@+id/ad_attribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/ad_badge_background"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="@string/ad_badge"
        android:textColor="@color/pazia_accent_light"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <!-- Ad creative image -->
        <ImageView
            android:id="@+id/ad_media"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/ad_media_background"
            android:clipToOutline="true"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Headline -->
            <TextView
                android:id="@+id/ad_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/pazia_white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Rating + category row -->
            <LinearLayout
                android:id="@+id/ad_meta_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/ad_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pazia_accent_light"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ad_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/pazia_gray_light"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Body text -->
            <TextView
                android:id="@+id/ad_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="top"
                android:maxLines="2"
                android:textColor="@color/pazia_gray_light"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- CTA button -->
    <Button
        android:id="@+id/ad_call_to_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="10dp"
        android:background="@drawable/ad_cta_background"
        android:minHeight="40dp"
        android:paddingHorizontal="18dp"
        android:stateListAnimator="@null"
        android:textAllCaps="false"
        android:textColor="@color/pazia_white"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
